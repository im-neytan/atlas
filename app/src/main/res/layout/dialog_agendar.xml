<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#101722">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agendar Transferência de Dados"
        android:textColor="#F8FAFC"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="O pedido será inserido na fila e processado pelo SIM selecionado."
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Número do Destinatário"
        android:textColor="#38BDF8"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etNumeroDestino"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="12dp"
        android:background="#182232"
        android:hint="+244 923 000 000"
        android:textColor="#F8FAFC"
        android:textColorHint="#64748B"
        android:inputType="phone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Quantidade de Megas (MB / GB)"
        android:textColor="#38BDF8"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etQuantidadeMegas"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="12dp"
        android:background="#182232"
        android:hint="Ex: 500 MB ou 2 GB"
        android:textColor="#F8FAFC"
        android:textColorHint="#64748B"
        android:inputType="text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:textColor="#94A3B8"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnConfirmar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Confirmar Agendamento"
            android:textColor="#090D12"
            android:backgroundTint="#00E676" />
    </LinearLayout>
</LinearLayout>
